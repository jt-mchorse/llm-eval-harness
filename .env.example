# Copy to .env (gitignored) and fill in. Nothing loads it automatically:
#   set -a; . ./.env; set +a
# The hermetic flow (`pytest`, the examples, `validate`, `drift --judge-stub`)
# needs none of these.

# Anthropic API key for the live judge (`calibrate`, `run` with the real
# backend). `anthropic.Anthropic()` reads it implicitly.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model the live judge scores with. Default: claude-haiku-4-5-20251001.
EVAL_HARNESS_JUDGE_MODEL=claude-haiku-4-5-20251001

# Token for the PR-comment CLI (`eval-harness comment`), e.g. ghp_... . Fill in
# ONE of these. GITHUB_TOKEN wins when both are set, so both ship blank: a
# placeholder here used to beat a real GH_TOKEN once the file was loaded (#297).
# In Actions, `permissions: pull-requests: write` supplies GITHUB_TOKEN.
GITHUB_TOKEN=
GH_TOKEN=
