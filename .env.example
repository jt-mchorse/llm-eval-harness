# Copy to .env (gitignored) and fill in. Nothing loads it automatically:
#   set -a; . ./.env; set +a
# The hermetic flow (`pytest`, the examples, `validate`, `drift --judge-stub`)
# needs none of these.

# Anthropic API key for the live judge (`calibrate`, `run` with the real
# backend). `anthropic.Anthropic()` reads it implicitly.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model the live judge scores with. Default: claude-haiku-4-5-20251001.
EVAL_HARNESS_JUDGE_MODEL=claude-haiku-4-5-20251001

# Token for the PR-comment CLI (`eval-harness comment`). GITHUB_TOKEN wins
# when both are set; in Actions, `permissions: pull-requests: write` supplies it.
GITHUB_TOKEN=ghp_your-token-here
GH_TOKEN=
